# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore, with the addition of

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv/
.env

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Documentation and markdown files
*.md
docs/
README*
CHANGELOG*
LICENSE*

# Git files
.git/
.gitignore
.gitattributes

# CI/CD files (not needed in container)
.github/
cloudbuild.yaml
.dockerignore

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
.cache/

# Security files (should come from Secret Manager)
*.key
*.pem
*.p12
service-account-key.json

# Tuning and experimental files
tuning/
experiments/
notebooks/
*.ipynb

# Database files
*.db
*.sqlite
*.sqlite3

# OS generated files
Thumbs.db
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Package management
pip-log.txt
pip-delete-this-directory.txt

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# Backup files
*.bak
*.backup
*~

# Large data files
*.csv
*.json
*.xml
data/
datasets/

# Build artifacts
build/
dist/
*.tar.gz
*.zip

# Security scanning results
bandit-report.json
safety-report.json
.snyk
